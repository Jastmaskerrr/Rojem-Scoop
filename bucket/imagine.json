                    "Imagine64.exe",
                    "Imagine"
                ]
            ]
        },
        "32bit": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/0f005803e2984097bb74a8f8b7d98fe3b97753db/Imagine_2.6.5_Unicode_Full.zip",
            "hash": "a2701c48b040739fef6d1564dbe3b759341f916c2862d7d0bf05bdffbed3ea83",
            "bin": "Imagine.exe",
            "shortcuts": [
